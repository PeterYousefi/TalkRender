# ==========================================
# TALKRENDER ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Boson AI Higgs Realtime Configuration
BOSON_API_KEY=your_boson_api_key
BOSON_REALTIME_WS_URL=wss://api.boson.ai/v1/realtime

# Boson Higgs Avatar Configuration
BOSON_AVATAR_API_URL=https://api.boson.ai/v1/avatar
NEXT_PUBLIC_DEFAULT_AVATAR_ID=higgs-avatar-cyber-copilot

# Application Runtime Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
